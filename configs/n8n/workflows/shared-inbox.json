              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "inboxsecret00001",
          "name": "Inbox secret"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "whisper",
      "name": "Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:9090/v1/audio/transcriptions",
        "sendBody": true,
        "contentType": "multipart-form-data",
