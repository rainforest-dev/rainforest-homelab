    {
      "id": "pick",
      "name": "Pick new",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        240
      ],
      "parameters": {
        "jsCode": "// Turns everything the three folder reads found into work items, once.\n// Ledger and attempt counts live in workflow static data, which n8n persists for\n// production (trigger) executions. A file is sent at most MAX_ATTEMPTS times; after\n// that it is reported once as rejected and skipped until renamed.\nconst MAX_ATTEMPTS = 3;\nconst PER_RUN = 20;\nconst ROOT = '/home/node/.n8n-files/inbox';\nconst sd = $getWorkflowStaticData('global');\nsd.processed = sd.processed || {};\nsd.attempts = sd.attempts || {};\nsd.rejected = sd.rejected || {};\n\nconst notes = $('List voice notes').first().json;\nconst voiceNotes = new Set(Array.isArray(notes.files) ? notes.files : []);\nconst noteBase = (name) => name.replace(/\\.[^.]+$/, '').replace(/[\\\\/:*?\"<>|]/g, '-');\n\nconst found = [];\nconst collect = (nodeName, target) => {\n  for (const item of $(nodeName).all()) {\n    const bin = item.binary && item.binary.data;\n    if (!bin || !bin.fileName) continue;\n    const name = bin.fileName;\n    if (name.startsWith('.') || name.endsWith('.icloud')) continue;\n    const dir = bin.directory || '';\n    let notebook = null;\n    if (target === 'bujo') {\n      const rel = dir.startsWith(ROOT + '/bujo') ? dir.slice((ROOT + '/bujo').length).replace(/^\\/+/, '') : '';\n      notebook = rel.split('/')[0] || 'Unsorted';\n    }\n    const key = `${target}:${dir}/${name}:${bin.fileSize || ''}`;\n    found.push({ key, target, notebook, name, binary: item.binary });\n  }\n};\ncollect('Read bujo', 'bujo');\ncollect('Read voice', 'voice');\ncollect('Read legacy voice', 'voice');\n\nconst out = [];\nfor (const f of found) {\n  if (sd.processed[f.key] || sd.rejected[f.key]) continue;\n  if (f.target === 'voice' && voiceNotes.has(noteBase(f.name) + '.md')) {\n    sd.processed[f.key] = new Date().toISOString();\n    continue;\n  }\n  const tries = (sd.attempts[f.key] || 0) + 1;\n  if (tries > MAX_ATTEMPTS) {\n    sd.rejected[f.key] = new Date().toISOString();\n    delete sd.attempts[f.key];\n    out.push({ json: { target: 'rejected', key: f.key, detail: `${f.target}: ${f.name} failed ${MAX_ATTEMPTS} times` } });\n    continue;\n  }\n  if (out.filter((o) => o.json.target !== 'rejected').length >= PER_RUN) continue;\n  sd.attempts[f.key] = tries;\n  out.push({ json: { key: f.key, target: f.target, notebook: f.notebook, src: f.name, noteName: noteBase(f.name), source: 'icloud' }, binary: f.binary });\n}\n\nconst keys = Object.keys(sd.processed);\nif (keys.length > 5000) {\n  keys.sort((a, b) => sd.processed[a].localeCompare(sd.processed[b]));\n  for (const k of keys.slice(0, keys.length - 5000)) delete sd.processed[k];\n}\nreturn out;"
      },
      "executeOnce": true
    },
    {
      "id": "fromupload",
      "name": "From upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        560
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalises a webhook upload to the same item shape the folder scan produces.\n// POST /webhook/inbox-upload-0001/inbox/<target>, multipart: one file in any field, plus optional\n// `notebook` (bujo) and `source`.\nconst TARGETS = ['bujo', 'voice'];\nconst target = String(($json.params && $json.params.target) || '').toLowerCase();\nif (!TARGETS.includes(target)) {\n  throw new Error(`Unknown inbox target \"${target}\". Known: ${TARGETS.join(', ')}`);\n}\nconst body = $json.body || {};\nconst binaries = $input.item.binary || {};\nconst field = Object.keys(binaries)[0];\nif (!field) throw new Error('No file in the upload');\nconst bin = binaries[field];\nconst name = bin.fileName || 'upload';\nreturn {\n  json: {\n    key: null,\n    target,\n    notebook: target === 'bujo' ? String(body.notebook || 'Unsorted') : null,\n    src: name,\n    noteName: name.replace(/\\.[^.]+$/, '').replace(/[\\\\/:*?\"<>|]/g, '-'),\n    source: String(body.source || 'upload'),\n  },\n  binary: { data: bin },\n};"
      }
    },
    {
      "id": "route",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        900,
        400
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r1",
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "bujo",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "bujo"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r2",
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "voice",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "voice"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "r3",
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "rejected",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "rejected"
            }
          ]
        },
        "options": {}
      }
    },
    {
