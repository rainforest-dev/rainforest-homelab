    },
    {
      "id": "readvoice",
      "name": "Read voice",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        220,
        240
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/home/node/.n8n-files/inbox/voice/*.*",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "continueOnFail": true,
