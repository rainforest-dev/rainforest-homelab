    {
      "id": "build",
      "name": "Build note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const routed = $('Route').item.json;\nconst text = ($json.text || '').trim();\nconst now = new Date().toISOString();\nconst body = [\n  '---',\n  'type: voice-memo',\n  `source: ${routed.src}`,\n  `date: ${now.slice(0, 10)}`,\n  `transcribed: ${now}`,\n  '---',\n  '',\n  text || '_(empty transcription)_',\n  '',\n].join('\\n');\nreturn { json: { noteName: routed.noteName, body } };"
      }
    },
    {
      "id": "note",
      "name": "Create note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        400
      ],
      "parameters": {
        "method": "PUT",
        "url": "=https://host.docker.internal:27124/vault/Voice%20memos/{{ encodeURIComponent($json.noteName) }}.md",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "text/markdown"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/markdown",
        "body": "={{ $json.body }}",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "obsidianrestapi1",
          "name": "Obsidian Local REST API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "report",
      "name": "Report rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        600
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/ha-events",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'inbox_rejected', detail: $json.detail, ts: $now.toISO() }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "continueOnFail": true
    },
    {
      "id": "done",
      "name": "Mark done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        320
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Records a delivered folder file in the ledger; uploads carry no key.\nconst routed = $('Route').item.json;\nconst sd = $getWorkflowStaticData('global');\nif (routed.key) {\n  sd.processed = sd.processed || {};\n  sd.processed[routed.key] = new Date().toISOString();\n  if (sd.attempts) delete sd.attempts[routed.key];\n}\nreturn { json: { ok: true, target: routed.target, src: routed.src, result: $json } };"
      }
    }
  ],
