    },
    {
      "id": "upload",
      "name": "Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -440,
        560
      ],
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "path": "inbox/:target",
        "responseMode": "lastNode",
        "options": {
