      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8082/api/inbox/bujo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
