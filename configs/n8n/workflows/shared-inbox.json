    },
    {
      "id": "readbujo",
      "name": "Read bujo",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/home/node/.n8n-files/inbox/bujo/**/*.*",
        "options": {
          "dataPropertyName": "data"
        }
      },
