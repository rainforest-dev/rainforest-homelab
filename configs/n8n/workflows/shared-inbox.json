    },
    {
      "id": "readlegacy",
      "name": "Read legacy voice",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        440,
        240
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/home/node/.n8n-files/voice-inbox/*.*",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "continueOnFail": true,
      "alwaysOutputData": true,
