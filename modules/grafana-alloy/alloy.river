// ─── Prometheus: Mac Mini system metrics (native node_exporter on host) ─────

prometheus.scrape "unix" {
  targets = [{
    __address__ = "host.docker.internal:9100",
    job         = "mac-mini-node",
  }]
  forward_to      = [prometheus.remote_write.rpi.receiver]
  scrape_interval = "30s"
  job_name        = "mac-mini-node"
}

// ─── Prometheus: Push to RPi ────────────────────────────────────────────────

prometheus.remote_write "rpi" {
  endpoint {
    url = env("PROMETHEUS_REMOTE_WRITE_URL")

    queue_config {
      max_samples_per_send = 1000
      batch_send_deadline  = "5s"
    }
  }
}

// ─── Loki: Docker container logs ────────────────────────────────────────────

discovery.docker "running" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.running.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  rule {
    replacement  = "docker"
    target_label = "job"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.process.drop_self.receiver]
}

loki.process "drop_self" {
  forward_to = [loki.write.rpi.receiver]

  stage.drop {
    source = "container_name"
    value  = "homelab-alloy"
  }
}

// ─── Loki: Push to RPi ──────────────────────────────────────────────────────

loki.write "rpi" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}

// ─── OTLP: agent CLI telemetry (Claude Code, Codex) ─────────────────────────
//
// Claude Code and Codex export over OTLP; nothing else on this host does. Both
// signals fan back into the SAME two writers the rest of this file already uses,
// so agent telemetry lands beside host metrics and container logs rather than in
// a parallel stack.
//
// Logs deliberately bypass loki.process.drop_self: that stage exists to stop
// Alloy logging its own container output back to itself, and has nothing to say
// about OTLP payloads.

otelcol.receiver.otlp "agents" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.agents.input]
    logs    = [otelcol.processor.batch.agents.input]
  }
}

// CLI processes are short-lived and the OTel SDK drops silently if the collector
// is slow, so keep the batch window well under a typical session.
otelcol.processor.batch "agents" {
  timeout = "2s"

  output {
    metrics = [otelcol.exporter.prometheus.agents.input]
    logs    = [otelcol.exporter.loki.agents.input]
  }
}

otelcol.exporter.prometheus "agents" {
  forward_to = [prometheus.remote_write.rpi.receiver]
}

otelcol.exporter.loki "agents" {
  forward_to = [loki.write.rpi.receiver]
}
